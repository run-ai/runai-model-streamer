# Shared SDK pins are owned by the devcontainer, not application build settings.
local_repository(name = "gcs_sdk_config", path = "../.devcontainer/gcs/config")

load("//toolchain:configure.bzl", "configure_toolchain")
configure_toolchain(name = "toolchain")
load("//toolchain:deps.bzl", "load_toolchain_deps")
load_toolchain_deps()

# Starlark regression tests for prebuilt SDK validation.
register_toolchains("@bazel_skylib//toolchains/unittest:bash_toolchain")

load("//:rules.bzl", "runai_cc_test_dependencies")
runai_cc_test_dependencies()

new_local_repository(
    name = "cuda",
    path = "/usr/local/cuda",
    build_file = "//third_party:cuda.BUILD"
)

new_local_repository(
    name = "aws",
    path = "/opt",
    build_file = "//third_party:aws.BUILD"
)

new_local_repository(
    name = "azure",
    path = "/opt",
    build_file = "//third_party:azure.BUILD"
)

new_local_repository(
    name = "uring",
    path = "/opt",
    build_file = "//third_party:uring.BUILD"
)

new_local_repository(
    name = "aio",
    path = "/opt",
    build_file = "//third_party:aio.BUILD"
)

# The devcontainer prebuilds the SDK for its installed architectures.
# Application builds only compile our GCS adapter and tests.
load("//third_party:gcp_repo.bzl", "load_prebuilt_gcp_repo")
load_prebuilt_gcp_repo()
